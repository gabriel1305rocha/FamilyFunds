PORT=3000
DATABASE_URL=postgres://familyfunds:familyfunds@localhost:5432/familyfunds
TEST_DATABASE_URL=postgres://familyfunds:familyfunds@localhost:5432/familyfunds_test
# Gere um segredo forte em produção: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
# Origens do app web permitidas (separe por vírgula). Vazio = qualquer origem.
CORS_ORIGIN=
# Tentativas de login/cadastro por IP a cada 15 minutos
AUTH_RATE_LIMIT=20
# Quantos proxies reversos ficam à frente da API (ex.: 1 atrás de Nginx/Caddy)
TRUST_PROXY=0
